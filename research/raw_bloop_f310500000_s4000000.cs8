␀␀‏‏	שרנל		ÝÚ9בÍקB<דÈטA/ÒÃ‎'9ÅÅ9(‏ÂÒ,BלÆג8C‎×ÒצA>חÊהB0ÓÃש"<ÈÄ6+ÁÌ$?ןÄÞ7DÜÎסA@יËב	C5ÙÅפ!= ÈÄ20ÁÌ">צÃØ1D	בÍל?BסÑÙ␀C7ÜÄנ@(ÍÃ.4ÃÈ;$‎ÂÔ/DוÈו;CרÔÕ‎C;ב